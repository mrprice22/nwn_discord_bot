<?xml version="1.0" encoding="UTF-16"?>
<!--
  Task Scheduler definition for `python -m nwnbot serve` on the Windows host.
  The counterpart of systemd/nwnbot.service, which now describes only the Linux
  box; this file describes the machine that actually runs the bot.

  Deliberately ships DISABLED (<Enabled>false</Enabled> below) and with no boot
  trigger. This task is the one thing in the repo that can write to a public
  player forum and to the roadmap the admin uses daily, and neither has an undo.
  Arming it is a decision, not a default. Work up to it in this order:

      powershell -ExecutionPolicy Bypass -File windows\run-nwnbot.ps1 -Command doctor
      powershell -ExecutionPolicy Bypass -File windows\run-nwnbot.ps1 -Command plan

  and only then, with NWNBOT_DRY_RUN=1 still set in .env:

      schtasks /Create /TN nwnbot /XML windows\nwnbot-task.xml
      schtasks /Change /TN nwnbot /ENABLE

  NWNBOT_DRY_RUN is the live/not-live switch and it lives in .env, not here:
  with NWNBOT_DRY_RUN=1 this task plans on every forum event and every 15
  minutes and writes nothing anywhere. Setting it to 0 is the second, separate
  decision. Neither this file nor run-nwnbot.ps1 sets it, so re-registering or
  restarting the task can never quietly arm the bot.

  UserId is left as the placeholder BOT_RUN_AS_USER on purpose: fill it in with
  your own account when you register the task, so the credentials in .env are
  read as you and by nobody else.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>nwnbot - Discord forum &lt;-&gt; roadmap sync. See plan.md. Ships disabled; arming it is a decision.</Description>
    <URI>\nwnbot</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>BOT_RUN_AS_USER</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <!-- The arming switch. Enabling is the decision described in the header. -->
    <Enabled>false</Enabled>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- A crash is a bug to look at, not a reason to stop syncing; but a bad
         token or a missing .env is not something restarting will fix. Five
         tries at 30s, then give up rather than spinning against Discord's
         login endpoint. Mirrors Restart=on-failure / StartLimitBurst=5. -->
    <RestartOnFailure>
      <Interval>PT30S</Interval>
      <Count>5</Count>
    </RestartOnFailure>
    <!-- Background work with no deadline: never compete with the NWN server. -->
    <Priority>7</Priority>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <!-- A long-running sync loop, not a job with an end. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <!-- run-nwnbot.ps1 is the EnvironmentFile= equivalent: it loads .env into
           the environment, because nothing in nwnbot/ ever reads .env itself. -->
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "windows\run-nwnbot.ps1" -Command serve</Arguments>
      <WorkingDirectory>BOT_REPO_DIR</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
