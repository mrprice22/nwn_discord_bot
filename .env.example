# Copy this to .env and fill in your values — .env is gitignored and never committed

# Discord
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-server-id-here
# The bot account's own Discord user id. Loop prevention, layer one: every
# message authored by this id is skipped, so the bot never reacts to its own
# posts. Required — left unset it defaults to "" and the layer silently does
# nothing. Enable Developer Mode in Discord, then right-click the bot's own
# name -> Copy User ID.
DISCORD_BOT_USER_ID=your-bot-user-id-here
DISCORD_BUGS_FORUM_ID=your-bugs-forum-channel-id-here
DISCORD_FEATURES_FORUM_ID=your-feature-requests-forum-channel-id-here

# Roadmap editor API (the cloudflared tunnel; use http://127.0.0.1:8765 when colocated)
ROADMAP_BASE_URL=https://roadmap.homerslotr.com
ROADMAP_USER=your-roadmap-bot-username-here
ROADMAP_PASSWORD=your-roadmap-bot-password-here

# Local state
NWNBOT_DB=state.db
# Discord user id -> roadmap player name. Gitignored, never committed: it maps
# real people. Seed the skeleton with
#   python -m nwnbot doctor --check-roadmap --seed-players players.json
# then fill in the ids by hand. Nothing is matched by display name.
NWNBOT_PLAYERS=players.json

# Safety: 1 = plan only, never write to Discord or the roadmap. Set to 0 deliberately.
NWNBOT_DRY_RUN=1

# Duplicate detection thresholds ([b9-dupes], review item [r6]). Optional —
# the defaults are compiled into config.py. The bot NEVER writes `dupe_of`:
# below the low threshold it says nothing, between the two it files a review
# entry, and at or above the high one it also posts a "possible duplicate" line
# in the reporter's thread. In every band the new idea is created normally, so a
# false positive can never swallow a real report. A duplicate becomes real only
# when a DM or admin sets `dupe_of` in the roadmap editor.
# Pick these from `python -m nwnbot dupes --calibrate`, not from taste.
#NWNBOT_DUPE_LOW=0.55
#NWNBOT_DUPE_HIGH=0.85
